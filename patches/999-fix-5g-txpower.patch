--- a/mt76x2/eeprom.c
+++ b/mt76x2/eeprom.c
@@ -115,6 +115,10 @@ mt76x2_get_power_info_5g(struct mt76x02_dev *dev,
 
 	mt76x02_eeprom_copy(dev, offset, data, sizeof(data));
 	t->chain[chain].tssi_slope = data[0];
 	t->chain[chain].tssi_offset = data[1];
-	t->chain[chain].target_power = data[2];
+	t->chain[chain].target_power = data[2];
+	/* Force 23 dBm if EEPROM returns 0 (broken on some MT76x2 chips) */
+	if (t->chain[chain].target_power == 0 ||
+	    t->chain[chain].target_power == 0xff)
+		t->chain[chain].target_power = 23;
 	t->chain[chain].delta =
 		mt76x02_sign_extend_optional(data[delta_idx], 7);
 
@@ -139,6 +143,15 @@ void mt76x2_get_power_info(struct mt76x02_dev *dev,
 	if (mt76x2_tssi_enabled(dev) ||
 	    !mt76x02_field_valid(t->target_power))
 		t->target_power = t->chain[0].target_power;
+	/* Fallback: ensure target_power is sane */
+	if (t->target_power == 0 || t->target_power == 0xff)
+		t->target_power = 23;
+	/* Also fix per-chain if still zero */
+	if (t->chain[0].target_power == 0 ||
+	    t->chain[0].target_power == 0xff)
+		t->chain[0].target_power = 23;
+	if (t->chain[1].target_power == 0 ||
+	    t->chain[1].target_power == 0xff)
+		t->chain[1].target_power = 23;
 
 	t->delta_bw40 = mt76x02_rate_power_val(bw40);
 	t->delta_bw80 = mt76x02_rate_power_val(bw80);
